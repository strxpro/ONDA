# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (BotFather) — webhook secret: any random 32+ char string
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI — the bot's "brain" + voice → text.
# FREE: just GROQ_API_KEY (console.groq.com → API Keys). One key does both: understands commands and transcribes voice.
GROQ_API_KEY=
# Optional alternatives for the brain (first one set wins: Anthropic → Groq → Gemini → xAI; AI_PROVIDER forces one):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# AI_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# XAI_MODEL=grok-4
# voice → text falls back to OpenAI only if GROQ_API_KEY is empty
OPENAI_API_KEY=

# Cookieless analytics: random 32+ char string, never rotate mid-day
ANALYTICS_SALT=

# Public site URL (used for the webhook, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin (used by `npm run db:seed-sql` and by the local file store)
ADMIN_EMAIL=
ADMIN_TELEGRAM_ID=

# Optional: real Google rating + reviews (Places API New) — admin → Recensioni → "Google"
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
