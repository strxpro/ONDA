# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (BotFather) — webhook secret: any random 32+ char string
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI — the bot's "brain" + voice → text.
# FREE: every key you add joins a chain; when one free AI is busy or out of quota the next answers, silently.
GROQ_API_KEY=          # console.groq.com — also transcribes voice notes and sees photos (qwen)
GEMINI_API_KEY=        # aistudio.google.com — sees photos
CEREBRAS_API_KEY=      # cloud.cerebras.ai — 1M tokens a day
OPENROUTER_API_KEY=    # openrouter.ai — the ":free" models
MISTRAL_API_KEY=       # console.mistral.ai — free "Experiment" plan
XAI_API_KEY=
# (no key at all: Pollinations is the last resort)
# AI_ORDER=groq,cerebras,gemini,openrouter,mistral   # optional order;  GROQ_MODELS=a,b  overrides a provider's models
# Claude instead of the free chain:
ANTHROPIC_API_KEY=

# FREE image AI for missing ingredient photos (first one set is used):
CF_ACCOUNT_ID=         # Cloudflare → Workers AI (free daily allowance, FLUX)
CF_API_TOKEN=
HF_TOKEN=              # huggingface.co → Access Tokens
POLLINATIONS_TOKEN=    # enter.pollinations.ai
# voice → text falls back to OpenAI only if GROQ_API_KEY is empty
OPENAI_API_KEY=

# Cookieless analytics: random 32+ char string, never rotate mid-day
ANALYTICS_SALT=

# Public site URL (used for the webhook, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin (used by `npm run db:seed-sql` and by the local file store)
ADMIN_EMAIL=
ADMIN_TELEGRAM_ID=

# Optional: real Google rating + reviews (Places API New) — admin → Recensioni → "Google"
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
